# Production build defaults - production mode values (dev mode uses .env.development).
# API lives on its own subdomain; CORS must allow this web origin.
VITE_API_BASE_URL=https://frama-api.custospark.com/api/v1

VITE_APP_VERSION=1.0.0

# Public-facing URL for manager report links (QR codes, WhatsApp)
VITE_APP_URL=https://frama.custospark.com
VITE_CURRENCY=UGX
